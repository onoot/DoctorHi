# Example environment file
# Copy to .env and edit for local development

# NODE_ENV should be 'production' in production
NODE_ENV=development

# When set to 'true' and NODE_ENV != 'production', an insecure dev-only
# authentication bypass will be enabled. DO NOT enable on production.
ALLOW_INSECURE_DEV=false

# Port for development server
PORT=3001# Настройки сервера
PORT=3000
NODE_ENV=development

# Настройки базы данных
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=doctor_heights

# Настройки JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=24h

# Настройки загрузки файлов
UPLOAD_DIR=uploads/documents
MAX_FILE_SIZE=5242880 # 5MB 